{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantumverse.dev/spec/schemas/certificate.schema.json",
  "title": "Birth certificate — commissioning record (RFC-0005)",
  "type": "object",
  "required": ["certificate_version", "suite", "width", "issued", "checks", "passed"],
  "additionalProperties": false,
  "properties": {
    "certificate_version": { "const": "0.1" },
    "suite": { "type": "string", "pattern": "^qv-commissioning-v[0-9]+$" },
    "width": { "type": "integer", "minimum": 3, "maximum": 12 },
    "issued": { "type": "string", "format": "date-time" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "qubits", "tv_distance", "threshold", "pass", "capsule"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "qubits": { "type": "integer", "minimum": 1 },
          "shots": { "type": ["integer", "null"], "minimum": 1 },
          "tv_distance": { "type": "number", "minimum": 0, "maximum": 1 },
          "threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "pass": { "type": "boolean" },
          "capsule": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "passed": { "type": "boolean" }
  }
}
