{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantumverse.dev/spec/schemas/mitigation.schema.json",
  "title": "Capsule mitigation.json — the error-mitigation pipeline, exactly as applied (RFC-0001)",
  "type": "object",
  "required": ["pipeline"],
  "additionalProperties": false,
  "properties": {
    "pipeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "method"],
        "properties": {
          "step": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  }
}
